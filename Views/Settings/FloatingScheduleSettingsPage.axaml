<ci:SettingsPageBase x:Class="AdvancedTimeIsland.Views.Settings.FloatingScheduleSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                     xmlns:compat="clr-namespace:AdvancedTimeIsland.Views.Controls"
                     Loaded="OnLoaded"
                     Unloaded="OnUnloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <!-- settings-container / animated-intro：官方宿主样式，动画等级为“华丽”时子项依次淡入上滑 -->
        <StackPanel Classes="settings-container animated-intro">
            <TextBlock x:Name="TitleText"
                       Text="时间表悬浮窗"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- 主开关：单独卡片展示在最前（不放进折叠栏） -->
            <Border x:Name="EnableCard"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock x:Name="EnableTitleText"
                                   Text="启用悬浮时间表"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="EnableSubText"
                                   Text="打开后在桌面显示半透明悬浮课表窗口，关闭后窗口自动隐藏"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EnableToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsCheckedChanged="EnableToggle_Changed" />
                </Grid>
            </Border>

            <!-- 1. 基础外观 -->
            <compat:CompatSettingsExpander Header="基础外观"
                                           Description="悬浮窗的外观显示设置">
                <compat:CompatSettingsExpanderItem Content="课程名字号"
                                                   Description="课程名字体大小（单位 pt，范围 8 ~ 32，默认 18）；表头/时间/老师文字会按相对差值自动缩放">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <NumericUpDown x:Name="FontScaleBox"
                                       Width="160"
                                       Minimum="8"
                                       Maximum="32"
                                       Increment="1"
                                       FormatString="F0"
                                       HorizontalAlignment="Right"
                                       ValueChanged="FontScaleBox_ValueChanged" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="背景不透明度"
                                                   Description="仅作用于卡片背景（不影响文字/进度条可读性）：1.0 完全不透明，0 完全透明；默认 0.5">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <NumericUpDown x:Name="OpacityBox"
                                       Width="160"
                                       Minimum="0"
                                       Maximum="1"
                                       Increment="0.05"
                                       FormatString="F2"
                                       HorizontalAlignment="Right"
                                       ValueChanged="OpacityBox_ValueChanged" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="显示教师"
                                                   Description="关闭后悬浮窗不显示任何教师信息（下一项同时失效，但保留其设置值）。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="ShowTeacherToggle"
                                      IsCheckedChanged="ShowTeacherToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem x:Name="TeacherFullItem"
                                                   Content="启用教师全名（不推荐）"
                                                   Description="关闭时显示“X老师”（如：张老师）；开启后直接显示完整教师名（如：张三）。&#10;当科目未填写教师信息时不显示教师名。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="TeacherFullToggle"
                                      IsCheckedChanged="TeacherFullToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="显示明天课表"
                                                   Description="设置什么时候在悬浮窗显示明天课表。&#10;· 不显示：始终显示当天课表。&#10;· 放学后显示（默认）：当天放学后（或当天课表未加载时）自动切换为明天课表。&#10;· 总是显示：始终显示明天课表。&#10;· 无展示课程时显示：当天没有可展示课程时切换为明天课表。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ComboBox x:Name="TomorrowModeCombo"
                                  Width="220"
                                  HorizontalAlignment="Right"
                                  SelectionChanged="TomorrowModeCombo_SelectionChanged">
                            <ComboBoxItem>不显示</ComboBoxItem>
                            <ComboBoxItem>放学后显示（默认）</ComboBoxItem>
                            <ComboBoxItem>总是显示</ComboBoxItem>
                            <ComboBoxItem>无展示课程时显示</ComboBoxItem>
                        </ComboBox>
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="今天无课程时的占位符"
                                                   Description="显示当天课表、但当天没有课程时展示的文字；默认为“今天没有课程”。留空时回退为默认文案。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <TextBox x:Name="TodayPlaceholderBox"
                                 Width="220"
                                 HorizontalAlignment="Right"
                                 TextChanged="TodayPlaceholderBox_TextChanged" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="明天无课程时的占位符"
                                                   Description="显示明天课表、但明天没有课程时展示的文字；默认为“明天没有课程”。留空时回退为默认文案。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <TextBox x:Name="TomorrowPlaceholderBox"
                                 Width="220"
                                 HorizontalAlignment="Right"
                                 TextChanged="TomorrowPlaceholderBox_TextChanged" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
            </compat:CompatSettingsExpander>

            <!-- 2. 交互行为 -->
            <compat:CompatSettingsExpander Header="交互行为"
                                           Description="鼠标点击、指针淡化与贴边自动隐藏等交互设置">
                <compat:CompatSettingsExpanderItem Content="启用点击穿透"
                                                   Description="开启后，悬浮窗对鼠标点击事件完全透明，点击会命中下方窗口；同时拖拽悬浮窗功能会临时关闭（关闭穿透后恢复）。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="ClickThroughToggle"
                                      IsCheckedChanged="ClickThroughToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="指针移入淡化"
                                                   Description="参考 ClassIsland 主窗体淡化功能：当鼠标指针移动到悬浮窗区域上时，整体不透明度降到 5%；移出后恢复用户设置的不透明度。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="HoverFadeToggle"
                                      IsCheckedChanged="HoverFadeToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem x:Name="HoverFadeReverseItem"
                                                   Content="指针移入淡化（反转）"
                                                   Description="当启用指针移入淡化后再开启本项：变为“指针在悬浮窗外时淡化，移入窗口内恢复不透明”。适用于“常驻淡化，仅在操作时清晰”的场景。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="HoverFadeReverseToggle"
                                      IsCheckedChanged="HoverFadeReverseToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="贴边自动隐藏"
                                                   Description="开启后，把悬浮时间表拖到贴近屏幕边缘（&lt;8px）时会自动滑出屏幕、只保留约 6px 可见条；&#10;鼠标移入可见条区域时滑回原位，离开后再次隐藏。关闭时恢复贴边前位置。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="EdgeHideToggle"
                                      IsCheckedChanged="EdgeHideToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem x:Name="EdgeDelayItem"
                                                   Content="贴边隐藏延迟时间（秒）"
                                                   Description="判定贴边后等待本时长再滑出隐藏（光标离开可见条后同样延迟再隐藏）；&#10;范围 0 ~ 60，步长 1，精确到 0.1，默认 3 秒；0 表示立即隐藏。仅在开启贴边自动隐藏时生效。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <NumericUpDown x:Name="EdgeDelayBox"
                                       Width="160"
                                       Minimum="0"
                                       Maximum="60"
                                       Increment="1"
                                       FormatString="F1"
                                       HorizontalAlignment="Right"
                                       ValueChanged="EdgeDelayBox_ValueChanged" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
            </compat:CompatSettingsExpander>

            <!-- 3. 窗口与高级 -->
            <compat:CompatSettingsExpander Header="窗口与高级"
                                           Description="窗口层级、层级保护刷新频率与自动隐藏规则（高级设置）">
                <compat:CompatSettingsExpanderItem Content="悬浮窗层级"
                                                   Description="默认置底不会遮挡其他窗口；不推荐置顶，可能遮挡应用">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ComboBox x:Name="LayerCombo"
                                  Width="200"
                                  HorizontalAlignment="Right"
                                  SelectionChanged="LayerCombo_SelectionChanged">
                            <ComboBoxItem>置底</ComboBoxItem>
                            <ComboBoxItem>置顶（不推荐）</ComboBoxItem>
                        </ComboBox>
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="悬浮窗层级设置频率"
                                                   Description="ClassIsland 在什么时候重新把悬浮窗设回用户选择的层级（置底/置顶）。用于防止其他窗口挤占悬浮窗层级。&#10;高频设置会带来性能占用，并可能导致界面轻微闪烁。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ComboBox x:Name="RecheckCombo"
                                  Width="240"
                                  HorizontalAlignment="Right"
                                  SelectionChanged="RecheckCombo_SelectionChanged">
                            <ComboBoxItem>窗口层级变化时（默认）</ComboBoxItem>
                            <ComboBoxItem>前台窗口变化时</ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="每 50ms"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="⚠"
                                               FontSize="18"
                                               Foreground="#D08A2E"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="较高频率可能带来性能占用与轻微闪烁，仅当置顶频繁丢失时使用。" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="每 1ms"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="⚠"
                                               FontSize="18"
                                               Foreground="#E05A34"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="极高频率重设：明显占用 UI 线程、可能导致主窗口/悬浮窗闪烁，仅作极端调试用途。" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>每 2s</ComboBoxItem>
                        </ComboBox>
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="隐藏悬浮窗"
                                                   Description="在什么条件下自动隐藏悬浮窗。&#10;· 跟随主界面隐藏规则：主窗口隐藏时悬浮窗同步隐藏。&#10;· 基础模式：复用 ClassIsland 的“上课时隐藏 / 前台窗口最大化时隐藏 / 前台窗口全屏时隐藏”三个开关独立判定。&#10;· 高级模式（规则集）：复用 ClassIsland 主界面的隐藏规则集（在 ClassIsland 设置中编辑规则）。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ComboBox x:Name="HideModeCombo"
                                  Width="220"
                                  HorizontalAlignment="Right"
                                  SelectionChanged="HideModeCombo_SelectionChanged">
                            <ComboBoxItem>跟随主界面隐藏规则（默认）</ComboBoxItem>
                            <ComboBoxItem>基础模式</ComboBoxItem>
                            <ComboBoxItem>高级模式（规则集）</ComboBoxItem>
                            <ComboBoxItem>从不隐藏</ComboBoxItem>
                        </ComboBox>
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
            </compat:CompatSettingsExpander>

            <!-- 4. 随机窗口名（Footer 为主开关，与官方“实验性功能”开关样式一致） -->
            <compat:CompatSettingsExpander Header="随机窗口名"
                                           Description="为了防止弹窗拦截工具把时间表悬浮窗拦截，建议开启此项">
                <compat:CompatSettingsExpander.Footer>
                    <ToggleSwitch x:Name="RandomTitleToggle"
                                  IsCheckedChanged="RandomTitleToggle_Changed" />
                </compat:CompatSettingsExpander.Footer>
                <compat:CompatSettingsExpanderItem x:Name="EnhancedItem"
                                                   Content="增强随机模式"
                                                   Description="仅在上一项启用时生效：开启后每 1 秒重新设置一次随机窗口标题，防止拦截工具按标题缓存识别。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="EnhancedToggle"
                                      IsCheckedChanged="EnhancedToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="阻止截图"
                                                   Description="开启后，其他应用无法截取悬浮窗窗口内容，录制时也不会录制到悬浮窗。Windows 10 2004 及以上有效，更低版本回退为黑色遮挡。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="PreventCaptureToggle"
                                      IsCheckedChanged="PreventCaptureToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
            </compat:CompatSettingsExpander>

            <!-- 5. 独立进程模式（非 Windows 平台整组禁用） -->
            <compat:CompatSettingsExpander x:Name="IndependentGroup"
                                           Header="独立进程模式"
                                           Description="由独立进程 AdvancedTimeIslandFloatSchedule.exe 渲染悬浮窗，防弹窗拦截能力更强（超级模式），且不受 ClassIsland 主程序卡顿影响。仅支持 Windows，非 Windows 平台此项禁用。">
                <compat:CompatSettingsExpanderItem Content="独立进程模式"
                                                   Description="开启后悬浮课表改由独立进程渲染（进程名 AdvancedTimeIslandFloatSchedule）；关闭后回到进程内渲染。切换即时生效。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="IndependentToggle"
                                      IsCheckedChanged="IndependentToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem x:Name="RandomNameItem"
                                                   Content="随机进程名"
                                                   Description="以随机命名的临时副本启动子进程（任务管理器中进程名随机），进一步规避按进程名拦截。可能触发杀软误报，请知悉。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="RandomNameToggle"
                                      IsCheckedChanged="RandomNameToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="强制重启进程"
                                                   Description="立即终止并以当前设置重新启动子进程悬浮窗（约 1~2 秒恢复，无需重启 ClassIsland）。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <Button x:Name="RestartButton"
                                Content="重启"
                                Padding="14,5"
                                HorizontalAlignment="Right"
                                Click="RestartButton_Click" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="单实例保护"
                                                   Description="已有子进程实例时新进程直接退出并由插件接管连接。自下次子进程启动生效（无需重启）。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="SingleInstanceToggle"
                                      IsCheckedChanged="SingleInstanceToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="跟随启停"
                                                   Description="开启后，ClassIsland 关闭或异常停止后，此程序将关闭；关闭后悬浮窗冻结显示最后课表（进度本地续走），ClassIsland 重启后自动重连恢复推送。">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="FollowToggle"
                                      IsCheckedChanged="FollowToggle_Changed" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
                <compat:CompatSettingsExpanderItem Content="子进程状态"
                                                   Description="">
                    <compat:CompatSettingsExpanderItem.Footer>
                        <TextBlock x:Name="IndependentStatusText"
                                   Text="状态：未启用"
                                   FontSize="12" />
                    </compat:CompatSettingsExpanderItem.Footer>
                </compat:CompatSettingsExpanderItem>
            </compat:CompatSettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
