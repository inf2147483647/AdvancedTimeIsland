<Project Sdk="Microsoft.NET.Sdk">

    <!-- 时间表悬浮窗"独立进程模式"子进程。
         设计约束（见 .trae\documents\floating-schedule-independent-process-mode.md）：
         1. 框架依赖 + 单文件发布：产物只有一个 exe，Avalonia/Skia 运行时 DLL 一律不进插件包；
            运行时通过 AssemblyLoadContext.Resolving + PATH 注入从 ClassIsland 安装目录借用。
         2. 双 TFM 各出一个 exe，与宿主 Avalonia 代际精确配对：
            net8.0-windows  -> ClassIsland 2.0.x（Avalonia 11.3.x）
            net10.0-windows -> ClassIsland 2.1.x/Misha（Avalonia 12.1.x）
            Avalonia 程序集版本随包版本走，跨代二进制不兼容，不能一个 exe 通吃。
         3. 不引用 FluentAvalonia / ClassIsland.*：悬浮窗是纯代码 Avalonia 基础控件，
            颜色/字体全部由渲染模型显式携带，无需主题资源。 -->

    <PropertyGroup>
        <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>AdvancedTimeIslandFloatSchedule</AssemblyName>
        <RootNamespace>AdvancedTimeIsland.FloatScheduleChild</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\app.ico</ApplicationIcon>
        <!-- 宿主只装了更高版本 .NET（如 Misha 的 .NET 10）时也能启动 net8 产物 -->
        <RollForward>LatestMajor</RollForward>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <SelfContained>false</SelfContained>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
        <AvaloniaVersion Condition="'$(TargetFramework)' == 'net10.0-windows'">12.1.1</AvaloniaVersion>
        <AvaloniaVersion Condition="'$(TargetFramework)' != 'net10.0-windows'">11.3.10</AvaloniaVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <!-- 仅编译期引用（ref 程序集），运行时 DLL 由宿主目录解析，严禁进包 -->
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" ExcludeAssets="runtime;native" />
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" ExcludeAssets="runtime;native" />
        <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" ExcludeAssets="runtime;native" />
        <!-- 注意：不引用 Avalonia.Themes.Fluent。托盘图标/菜单已改为原生 Win32 实现
             （见 FloatScheduleTrayIcon.cs），原因见该文件头部说明：宿主 ClassIsland 使用
             FluentAvalonia，其依赖图中并不包含 Avalonia.Themes.Fluent，无法在运行时借用。 -->
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <!-- Avalonia 12 起"文本整形"被拆成独立包 Avalonia.HarfBuzz，AppBuilder 必须显式 UseHarfBuzz()，
             否则 Startup 直接抛 InvalidOperationException："No text shaping system configured"。
             Avalonia 11 无此包/此 API（整形内建于 UseSkia），故仅 net10 分支引用，避免 net8 侧解析失败。
             与其它 Avalonia 包一致：仅编译期引用，运行时 DLL 从宿主目录借用（宿主 FA3 目录里自带
             Avalonia.HarfBuzz.dll / HarfBuzzSharp.dll / libHarfBuzzSharp.dll），严禁进包。 -->
        <PackageReference Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" ExcludeAssets="runtime;native" />
    </ItemGroup>

    <ItemGroup>
        <!-- 液态玻璃背景捕获：DXGI Desktop Duplication（Shared\FloatingSchedule\FloatScheduleDxgiCapture.cs 使用）。
             【关键】绝不能像上面的 Avalonia.* 那样写 ExcludeAssets="runtime;native"：
             那些 Avalonia 运行时 DLL 是"故意从 ClassIsland 宿主目录借用"的，而宿主目录里**没有** Vortice，
             写 ExcludeAssets 会导致本子进程运行时缺 DLL（FileNotFoundException → 抓屏直接不可用）。
             故本引用保持默认（编译期 + 运行时资产都随包发布）。 -->
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- 与主项目共享的渲染模型/渲染器/IPC 协议/Win32 帮助类（同一份源码编入两侧，防渲染漂移） -->
        <Compile Include="..\Shared\FloatingSchedule\**\*.cs" LinkBase="Shared" />
        <!-- 窗口图标复用 ApplicationIcon 的压缩 ico（EmbeddedResource 字节流构造 WindowIcon，单文件发布下最稳） -->
        <EmbeddedResource Include="Assets\app.ico" />
    </ItemGroup>

    <!-- 包体优化：单文件发布会把 Vortice / SharpGen / System.Text.Json 等依赖整体嵌入 exe，
         而主插件包（cipx）目录里本来就带有同一依赖图解析出的同版本 DLL，运行时子进程会从
         exe 所在目录解析到它们。把它们标记为 ExcludeFromSingleFile 后，exe 只保留自身的
         AdvancedTimeIslandFloatSchedule.dll，同一批 DLL 不再在 cipx 里被打包两遍
         （实测 exe 从约 2.3MB/1.5MB 降到约 0.35MB）。
         前提：主插件包内必须存在同版本 DLL——主项目对 Vortice 的引用未排除任何资产，
         且两侧由同一次 restore 解析，版本天然一致；Build-Package.ps1 另做存在性校验。 -->
    <PropertyGroup>
        <_SharedDependencyNames>;Vortice.Direct3D11;Vortice.DirectX;Vortice.DXGI;Vortice.Mathematics;SharpGen.Runtime;SharpGen.Runtime.COM;System.Text.Json;System.IO.Pipelines;System.Text.Encodings.Web;</_SharedDependencyNames>
    </PropertyGroup>

    <Target Name="ExcludeSharedDependenciesFromSingleFileBundle" BeforeTargets="_ComputeFilesToBundle">
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$(_SharedDependencyNames.Contains(';%(Filename);'))" ExcludeFromSingleFile="true" />
            <_ResolvedFileToPublishPreserveNewest Update="@(_ResolvedFileToPublishPreserveNewest)" Condition="$(_SharedDependencyNames.Contains(';%(Filename);'))" ExcludeFromSingleFile="true" />
            <_ResolvedFileToPublishAlways Update="@(_ResolvedFileToPublishAlways)" Condition="$(_SharedDependencyNames.Contains(';%(Filename);'))" ExcludeFromSingleFile="true" />
        </ItemGroup>
    </Target>

</Project>
