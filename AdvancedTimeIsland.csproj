<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <CreateCipx>false</CreateCipx>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <!-- 按目标框架选择 SDK：
             net10.0（Misha 新版）使用 ClassIsland.PluginSdk/Core 2.1.1；
             net8.0（兼容版，支持旧版 ClassIsland）使用 1.7.106.2-dev-v2。
             由 Build-Package.ps1 通过 -p:TargetFramework 切换构建。 -->
        <ClassIslandPluginSdkVersion Condition="'$(TargetFramework)' == 'net10.0'">2.1.1</ClassIslandPluginSdkVersion>
        <ClassIslandPluginSdkVersion Condition="'$(TargetFramework)' != 'net10.0'">1.7.106.2-dev-v2</ClassIslandPluginSdkVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="ClassIsland.Core" Version="$(ClassIslandPluginSdkVersion)">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Markdig" Version="1.3.2" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="lunar">
            <HintPath>lunar.dll</HintPath>
            <Private>true</Private>
            <CopyLocal>true</CopyLocal>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Remove="qodana.yaml" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Assets\Icons\" />
      <Folder Include="Assets\Markdown\" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets\hanfupage\**\*" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Views\Main\AdvancedDateControl.axaml.cs" />
      <!-- 排除 WPF 版本代码，避免被 CI2 项目默认递归编译 -->
      <Compile Remove="AdvancedTimeIslandWPF\**\*.cs" />
      <None Remove="AdvancedTimeIslandWPF\**\*" />
      <Content Remove="AdvancedTimeIslandWPF\**\*" />
      <AvaloniaResource Remove="AdvancedTimeIslandWPF\**\*" />
      <Page Remove="AdvancedTimeIslandWPF\**\*" />
      <Resource Remove="AdvancedTimeIslandWPF\**\*" />
      <EmbeddedResource Remove="AdvancedTimeIslandWPF\**\*" />
    </ItemGroup>

    <!-- 打包逻辑已统一交给 Build-Package.ps1 中的 Create-CipxPackage 函数执行，
         避免 MSBuild Target 与 PowerShell 脚本重复打包（双重 ZIP 浪费时间 + 输出不一致）。 -->
    <Target Name="CreateCipxPackage" AfterTargets="Build" Condition="'$(CreateCipxPackageEnabled)' == 'true' and '$(Configuration)' == 'Release'">
        <PropertyGroup>
            <TempPackageDir>$(IntermediateOutputPath)CipxPackage</TempPackageDir>
            <CipxFileName>$(AssemblyName).cipx</CipxFileName>
            <CipxFilePath>$(OutputPath)$(CipxFileName)</CipxFilePath>
            <PackageSourceDir>$(OutputPath)</PackageSourceDir>
        </PropertyGroup>

        <Message Text="Creating .cipx package..." Importance="high" />
        <Message Text="Output directory: $(OutputPath)" Importance="high" />
        <Message Text="Package source: $(PackageSourceDir)" Importance="high" />
        <Message Text="Package file: $(CipxFilePath)" Importance="high" />

        <RemoveDir Directories="$(TempPackageDir)" />
        <MakeDir Directories="$(TempPackageDir)" />

        <ItemGroup>
            <PackageFiles Include="$(PackageSourceDir)*" Exclude="$(PackageSourceDir)*.pdb;$(PackageSourceDir)*.cipx;$(PackageSourceDir)*.zip;$(PackageSourceDir)win-x64\**\*;$(PackageSourceDir)android-arm64\**\*" />
            <PackageFiles Include="$(PackageSourceDir)Assets\Icons\**\*;$(PackageSourceDir)Assets\Markdown\**\*" Exclude="$(PackageSourceDir)Assets\**\*.pdb;$(PackageSourceDir)Assets\**\*.cipx;$(PackageSourceDir)Assets\**\*.zip" />
        </ItemGroup>

        <Copy SourceFiles="@(PackageFiles)" DestinationFiles="@(PackageFiles->'$(TempPackageDir)\%(RecursiveDir)%(Filename)%(Extension)')" />

        <Delete Files="$(TempPackageDir)\*.pdb" />
        <Delete Files="$(TempPackageDir)\*.cipx" />
        <Delete Files="$(TempPackageDir)\*.zip" />

        <Delete Files="$(CipxFilePath)" />

        <ZipDirectory SourceDirectory="$(TempPackageDir)" DestinationFile="$(CipxFilePath)" />

        <Message Text="Packaging successful!" Importance="high" />
        <Message Text="Package location: $(CipxFilePath)" Importance="high" />

        <RemoveDir Directories="$(TempPackageDir)" />
    </Target>

</Project>
