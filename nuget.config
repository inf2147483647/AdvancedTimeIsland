<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    无网构建支持（离线源 + 网络回退）：
    - 本地离线源指向仓库内 packages\ 目录，已预置全部构建依赖的 .nupkg（由 Sync-OfflinePackages 生成）。
    - <clear /> 清空更上级（用户/机器级）源的继承，保证离线源优先。
    - 仍保留 nuget.org 作为回退源：本地面缺失（如日后新增依赖）时，有网会自动补齐；无网且离线源缺失才会报错。
    新增依赖后，请重新执行 Sync-OfflinePackages.ps1 同步离线源，或手动将 .nupkg 放入 packages\。
  -->
  <packageSources>
    <clear />
    <add key="AdvancedTimeIsland-offline" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>