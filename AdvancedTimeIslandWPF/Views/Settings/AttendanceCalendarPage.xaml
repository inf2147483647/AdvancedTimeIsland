<ci:SettingsPageBase x:Class="AdvancedTimeIsland.Views.Settings.AttendanceCalendarPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     mc:Ignorable="d"
                     d:DesignHeight="700" d:DesignWidth="800"
                     Title="AttendanceCalendarPage"
                     TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                     Background="{DynamicResource MaterialDesignPaper}"
                     FontFamily="{DynamicResource HarmonyOsSans}"
                     TextElement.FontWeight="Regular"
                     TextElement.FontSize="14"
                     TextOptions.TextFormattingMode="Ideal"
                     TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">

            <ci:IconText Kind="CalendarCheck" Text="在校时间统计（ATI）" Margin="0 0 0 8" />

            <!-- ==================== 统计概览 ==================== -->
            <ci:SettingsCard IconGlyph="ChartDonut"
                             Header="统计概览"
                             Description="按当前学期区间与排除规则统计的在校情况"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <Button Content="刷新统计"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Click="OnRefreshClick" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <TextBlock x:Name="SummaryTextBlock"
                               Text="正在统计…"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <ProgressBar x:Name="SummaryProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="6"
                                 Margin="0,8,0,0"
                                 HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="SummaryDetailTextBlock"
                               Text=""
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBlock x:Name="SemesterRangeTextBlock"
                               Text=""
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- ==================== 学期区间 ==================== -->
            <Separator Margin="0 12 0 8" />
            <ci:IconText Kind="CalendarRange" Text="学期区间" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="StartSourceItem"
                                IconGlyph="CalendarStart"
                                Header="学期开始日"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <ComboBox Width="300"
                              HorizontalAlignment="Left"
                              SelectionChanged="OnSemesterOptionChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ManualStartDateItem"
                                IconGlyph="CalendarEdit"
                                Header="手动开始日"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <DatePicker Width="300"
                                HorizontalAlignment="Left"
                                SelectedDateChanged="OnSemesterDateChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="EndSourceItem"
                                IconGlyph="CalendarEnd"
                                Header="学期结束日"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <ComboBox Width="300"
                              HorizontalAlignment="Left"
                              SelectionChanged="OnSemesterOptionChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="TotalWeeksItem"
                                IconGlyph="CalendarWeek"
                                Header="学期总周数"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <helpers:WpfNumericUpDown Width="200"
                                              Minimum="1"
                                              Maximum="60"
                                              Increment="1"
                                              FormatString="0"
                                              HorizontalAlignment="Left"
                                              ValueChanged="OnSemesterNumberChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ManualEndDateItem"
                                IconGlyph="CalendarEdit"
                                Header="手动结束日"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <DatePicker Width="300"
                                HorizontalAlignment="Left"
                                SelectedDateChanged="OnSemesterDateChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="DailyHoursSourceItem"
                                IconGlyph="ClockTimeFourOutline"
                                Header="每日在校时长"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <ComboBox Width="300"
                              HorizontalAlignment="Left"
                              SelectionChanged="OnDailyHoursSourceChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock x:Name="DailyHoursHintTextBlock"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />

            <ci:SettingsControl x:Name="DailyHoursItem"
                                IconGlyph="TimerSand"
                                Header="每日在校时长（小时）"
                                Margin="0,4,0,8">
                <ci:SettingsControl.Switcher>
                    <helpers:WpfNumericUpDown Width="200"
                                              Minimum="0"
                                              Maximum="24"
                                              Increment="0.5"
                                              FormatString="0.#"
                                              HorizontalAlignment="Left"
                                              ValueChanged="OnSemesterNumberChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <!-- ==================== 排除规则 ==================== -->
            <Separator Margin="0 12 0 8" />
            <ci:IconText Kind="FilterVariant" Text="排除规则" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="ExcludeSaturdayItem"
                                Header="排除周六"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <CheckBox VerticalAlignment="Center"
                              Checked="OnRuleChanged"
                              Unchecked="OnRuleChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ExcludeSundayItem"
                                Header="排除周日"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <CheckBox VerticalAlignment="Center"
                              Checked="OnRuleChanged"
                              Unchecked="OnRuleChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ExcludeHolidaysItem"
                                Header="排除法定节假日（放假日）"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <CheckBox VerticalAlignment="Center"
                              Checked="OnRuleChanged"
                              Unchecked="OnRuleChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="CountMakeupDaysItem"
                                Header="调休补班日计为在校日（优先于周末排除）"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <CheckBox VerticalAlignment="Center"
                              Checked="OnRuleChanged"
                              Unchecked="OnRuleChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ExcludeVacationsItem"
                                Header="排除寒暑假区间"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <CheckBox VerticalAlignment="Center"
                              Checked="OnRuleChanged"
                              Unchecked="OnRuleChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="RespectCustomDatesItem"
                                Header="应用自定义日期（强制计入 / 强制排除）"
                                Margin="0,4,0,8">
                <ci:SettingsControl.Switcher>
                    <CheckBox VerticalAlignment="Center"
                              Checked="OnRuleChanged"
                              Unchecked="OnRuleChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <!-- ==================== 寒暑假区间 ==================== -->
            <Separator Margin="0 12 0 8" />
            <ci:IconText Kind="WeatherSunny" Text="寒暑假区间" Margin="0 0 0 8" />

            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="名称"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox x:Name="NewVacationNameTextBox"
                                 Width="150"
                                 Margin="6,0,0,0"
                                 materialDesign:HintAssist.Hint="如 2026 寒假" />
                        <TextBlock Text="开始"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <DatePicker x:Name="NewVacationStartDatePicker"
                                    Width="150"
                                    Margin="6,0,0,0" />
                        <TextBlock Text="结束"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <DatePicker x:Name="NewVacationEndDatePicker"
                                    Width="150"
                                    Margin="6,0,0,0" />
                        <Button Content="添加假期"
                                Margin="12,0,0,0"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnAddVacationClick" />
                    </WrapPanel>

                    <ScrollViewer MaxHeight="300"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="VacationListHost" />
                    </ScrollViewer>
                </StackPanel>
            </materialDesign:Card>

            <!-- ==================== 自定义日期 ==================== -->
            <Separator Margin="0 12 0 8" />
            <ci:IconText Kind="CalendarStar" Text="自定义日期" Margin="0 0 0 8" />

            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="日期"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <DatePicker x:Name="NewCustomDatePicker"
                                    Width="150"
                                    Margin="6,0,0,0" />
                        <TextBlock Text="名称"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox x:Name="NewCustomNameTextBox"
                                 Width="150"
                                 Margin="6,0,0,0"
                                 materialDesign:HintAssist.Hint="如 校运会" />
                        <ComboBox x:Name="NewCustomTypeComboBox"
                                  Width="150"
                                  Margin="12,0,0,0" />
                        <Button Content="添加日期"
                                Margin="12,0,0,0"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnAddCustomDateClick" />
                    </WrapPanel>

                    <ScrollViewer MaxHeight="300"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CustomListHost" />
                    </ScrollViewer>
                </StackPanel>
            </materialDesign:Card>

            <!-- ==================== 法定节假日与调休 ==================== -->
            <Separator Margin="0 12 0 8" />
            <ci:IconText Kind="CalendarRemove" Text="法定节假日与调休" Margin="0 0 0 8" />

            <materialDesign:Card>
                <StackPanel Margin="16">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="日期"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <DatePicker x:Name="NewHolidayDatePicker"
                                    Width="150"
                                    Margin="6,0,0,0" />
                        <TextBlock Text="名称"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox x:Name="NewHolidayNameTextBox"
                                 Width="150"
                                 Margin="6,0,0,0"
                                 materialDesign:HintAssist.Hint="如 春节" />
                        <ComboBox x:Name="NewHolidayTypeComboBox"
                                  Width="130"
                                  Margin="12,0,0,0" />
                        <Button Content="添加条目"
                                Margin="12,0,0,0"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnAddHolidayClick" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="从网络更新"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnUpdateFromNetworkClick" />
                        <Button Content="恢复内置数据"
                                Margin="8,0,0,0"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnRestoreBuiltinClick" />
                    </WrapPanel>

                    <TextBlock x:Name="StatusTextBlock"
                               Text=""
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />

                    <ScrollViewer MaxHeight="360"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HolidayListHost" />
                    </ScrollViewer>
                </StackPanel>
            </materialDesign:Card>

            <!-- ==================== 分段统计 ==================== -->
            <Separator Margin="0 12 0 8" />
            <ci:IconText Kind="TableLarge" Text="分段统计" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="PeriodModeItem"
                                IconGlyph="ViewGrid"
                                Header="分段方式"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <ComboBox Width="200"
                              HorizontalAlignment="Left"
                              SelectionChanged="OnPeriodModeChanged" />
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <materialDesign:Card Margin="0,4,0,0">
                <StackPanel Margin="16">
                    <ScrollViewer MaxHeight="400"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PeriodTableHost" />
                    </ScrollViewer>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
