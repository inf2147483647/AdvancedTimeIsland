<ci:SettingsPageBase x:Class="AdvancedTimeIsland.Views.Settings.DebugPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     mc:Ignorable="d"
                     d:DesignHeight="600" d:DesignWidth="800"
                     Title="DebugPage"
                     TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                     Background="{DynamicResource MaterialDesignPaper}"
                     FontFamily="{DynamicResource HarmonyOsSans}"
                     TextElement.FontWeight="Regular"
                     TextElement.FontSize="14"
                     TextOptions.TextFormattingMode="Ideal"
                     TextOptions.TextRenderingMode="Auto">
    <ScrollViewer>
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">
            <ci:IconText Kind="BugOutline" Text="调试" Margin="0 0 0 8" />

            <materialDesign:ColorZone Background="#22FF0000"
                                      Margin="0 0 0 8"
                                      Panel.ZIndex="1">
                <Grid TextElement.FontSize="13">
                    <DockPanel Margin="8 4 4 4">
                        <materialDesign:PackIcon Kind="Alert"
                                                 Margin="0 0 4 0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="仅供调试，除非你能知道您在做什么，请不要使用以下按钮。"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </materialDesign:ColorZone>

            <ci:SettingsCard IconGlyph="Alert"
                             Header="抛出异常测试"
                             Description="抛出一个未处理的异常，用于测试应用的异常处理。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <Button Content="开始"
                            Padding="16 8"
                            Click="ButtonCrash_OnClick" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <ci:SettingsCard IconGlyph="Bomb"
                             Header="强制崩溃测试"
                             Description="强制触发应用崩溃，用于测试应用的崩溃恢复机制。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <Button Content="开始"
                            Padding="16 8"
                            Click="ButtonForceCrash_OnClick" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <ci:SettingsCard IconGlyph="Fire"
                             Header="自毁测试"
                             Description="触发自毁序列，用于测试应用的自毁功能。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <Button Content="开始"
                            Padding="16 8"
                            Click="ButtonSelfDestruct_OnClick" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <ci:SettingsCard IconGlyph="BookOpen"
                             Header="汉服页面模板"
                             Description="进入汉服页面模板，用于预览和调试模板样式。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <Button Content="进入"
                            Padding="16 8"
                            Click="ButtonHanfuTemplate_OnClick" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="Memory" Text="内存泄漏测试" Margin="0 0 0 8" />

            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <TextBlock x:Name="MemoryLeakTitleTextBlock"
                               Text="内存泄漏测试"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0 0 0 8" />

                    <Grid Margin="0 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="每秒泄漏量"
                                   FontSize="14" />
                        <TextBox x:Name="MemoryLeakRateTextBox"
                                 Grid.Column="1"
                                 Width="100"
                                 FontSize="14"
                                 Padding="8 4"
                                 Margin="8 0 0 0"
                                 Text="100" />
                        <ComboBox x:Name="MemoryLeakUnitComboBox"
                                  Grid.Column="2"
                                  Width="80"
                                  FontSize="14"
                                  Padding="8 4"
                                  Margin="8 0 0 0" />
                    </Grid>

                    <Grid Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="已泄漏内存："
                                   FontSize="14" />
                        <TextBlock x:Name="MemoryLeakAmountTextBlock"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="0"
                                   FontSize="14" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0 12 0 0">
                        <Button x:Name="MemoryLeakStartButton"
                                Content="开始"
                                Padding="16 8"
                                Margin="0 0 8 0"
                                Click="MemoryLeakStartButton_OnClick" />
                        <Button x:Name="MemoryLeakClearButton"
                                Content="清除"
                                Padding="16 8"
                                Click="MemoryLeakClearButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
