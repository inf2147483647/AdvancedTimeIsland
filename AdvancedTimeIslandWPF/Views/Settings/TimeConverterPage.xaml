<UserControl x:Class="AdvancedTimeIsland.Views.Settings.TimeConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource HarmonyOsSans}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">
    <ScrollViewer>
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">
            <DockPanel LastChildFill="True" Margin="0 0 0 8">
                <ci:IconText Kind="SwapHorizontal" Text="时间格式转换"
                             DockPanel.Dock="Left" />
                <Button x:Name="ClearButton"
                        Content="清空"
                        Style="{DynamicResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Click="OnClearAllClick" />
            </DockPanel>

            <!-- 注意事项 -->
            <materialDesign:Card Margin="0 0 0 8">
                <StackPanel Margin="16">
                    <ci:IconText Kind="AlertCircleOutline" Text="注意事项" Margin="0 0 0 4" />
                    <TextBlock Text="• 转为区时/地方时前，需先选好对应的时区/经度，然后再转换"
                               TextWrapping="Wrap"
                               Margin="0 2 0 0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="• 试试连续点顶部通用区域的图标"
                               TextWrapping="Wrap"
                               Margin="0 2 0 0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="• 经度处填正数为东经，负数为西经，取值范围为 (-180, 180]"
                               TextWrapping="Wrap"
                               Margin="0 2 0 0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="• 在1582年之前使用儒略历，导致日期误差累积，为了纠正之前的误差，格里高利历把1582.10.4下一天变为1584.10.15，看起来中间“消失”了10天"
                               TextWrapping="Wrap"
                               Margin="0 2 0 0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 北京时间转换模块 -->
            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <ci:IconText Kind="ClockOutline" Text="北京时间" Margin="0 0 0 8" />

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalendarOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="日期输入" FontSize="14" />
                            <TextBlock Text="年 / 月 / 日"
                                       FontSize="12"
                                       Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <helpers:WpfNumericUpDown x:Name="BeijingYearTextBox"
                                                      Width="120"
                                                      Minimum="1" Maximum="9999"
                                                      Increment="1"
                                                      FormatString="0"
                                                      ValueChanged="OnBeijingValueChanged" />
                            <ComboBox x:Name="BeijingMonthComboBox"
                                      Width="80"
                                      Margin="4 0 0 0"
                                      SelectionChanged="OnBeijingSelectionChanged" />
                            <ComboBox x:Name="BeijingDayComboBox"
                                      Width="80"
                                      Margin="4 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="时间"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <helpers:WpfTimePicker x:Name="BeijingTimePicker"
                                               Grid.Column="2"
                                               Width="250"
                                               ClockIdentifier="24HourClock"
                                               UseSeconds="True"
                                               HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="选取当前时间"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BeijingCurrentButton"
                                Grid.Column="2"
                                Content="选取当前时间"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Right"
                                Click="OnBeijingCurrentTimeClick" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <Button Content="转为时间戳"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnBeijingToUnix" />
                        <Button Content="转为农历"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnBeijingToLunar" />
                        <Button Content="转为区时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnBeijingToZone" />
                        <Button Content="转为地方时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnBeijingToLocal" />
                    </StackPanel>

                    <TextBlock x:Name="BeijingResultTextBlock"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 时间戳转换模块 -->
            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <ci:IconText Kind="Timer" Text="时间戳" Margin="0 0 0 8" />

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Counter"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="输入" FontSize="14" />
                            <TextBlock Text="秒（支持小数）"
                                       FontSize="12"
                                       Opacity="0.75" />
                        </StackPanel>
                        <helpers:WpfNumericUpDown x:Name="UnixInputTextBox"
                                                  Grid.Column="2"
                                                  Width="275"
                                                  Minimum="-9223372036854775808"
                                                  Maximum="9223372036854775807"
                                                  Increment="1"
                                                  FormatString="0.###"
                                                  HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ContentCopy"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="复制时间戳到剪贴板"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <Button x:Name="CopyButton"
                                Grid.Column="2"
                                Content="复制"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Right"
                                Click="OnUnixCopyClick" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <Button Content="转为北京时间"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnUnixToBeijing" />
                        <Button Content="转为农历"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnUnixToLunar" />
                        <Button Content="转为区时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnUnixToZone" />
                        <Button Content="转为地方时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnUnixToLocal" />
                    </StackPanel>

                    <TextBlock x:Name="UnixResultTextBlock"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 农历转换模块 -->
            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <ci:IconText Kind="CalendarStar" Text="农历" Margin="0 0 0 8" />

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalendarRangeOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="年份范围"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LunarYearRangeComboBox"
                                  Grid.Column="2"
                                  Width="180"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ZodiacLibra"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="干支"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox x:Name="LunarTianganComboBox" Width="70" />
                            <ComboBox x:Name="LunarDizhiComboBox" Width="70" Margin="4 0 0 0" />
                            <TextBlock Text="年" VerticalAlignment="Center" Margin="4 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalendarMonthOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="月份"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LunarMonthComboBox"
                                  Grid.Column="2"
                                  Width="80"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalendarToday"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="日期"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LunarDayComboBox"
                                  Grid.Column="2"
                                  Width="70"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="时间"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <helpers:WpfTimePicker x:Name="LunarTimePicker"
                                               Grid.Column="2"
                                               Width="250"
                                               ClockIdentifier="24HourClock"
                                               UseSeconds="True"
                                               HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <Button Content="转为北京时间"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnLunarToBeijing" />
                        <Button Content="转为时间戳"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnLunarToUnix" />
                        <Button Content="转为区时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnLunarToZone" />
                        <Button Content="转为地方时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnLunarToLocal" />
                    </StackPanel>

                    <TextBlock x:Name="LunarResultTextBlock"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 区时转换模块 -->
            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <ci:IconText Kind="Earth" Text="区时" Margin="0 0 0 8" />

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalendarOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="日期输入" FontSize="14" />
                            <TextBlock Text="年 / 月 / 日"
                                       FontSize="12"
                                       Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <helpers:WpfNumericUpDown x:Name="ZoneYearTextBox"
                                                      Width="120"
                                                      Minimum="1" Maximum="9999"
                                                      Increment="1"
                                                      FormatString="0"
                                                      ValueChanged="OnZoneValueChanged" />
                            <ComboBox x:Name="ZoneMonthComboBox"
                                      Width="80"
                                      Margin="4 0 0 0"
                                      SelectionChanged="OnZoneSelectionChanged" />
                            <ComboBox x:Name="ZoneDayComboBox"
                                      Width="80"
                                      Margin="4 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="时间"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <helpers:WpfTimePicker x:Name="ZoneTimePicker"
                                               Grid.Column="2"
                                               Width="250"
                                               ClockIdentifier="24HourClock"
                                               UseSeconds="True"
                                               HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Web"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="时区"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox x:Name="ZoneComboBox" Width="200" />
                            <TextBlock Text="夏令时:" VerticalAlignment="Center" Margin="8 0 0 0" />
                            <CheckBox x:Name="ZoneDstCheckBox"
                                      Content="开启"
                                      VerticalAlignment="Center"
                                      Margin="4 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <Button Content="转为北京时间"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnZoneToBeijing" />
                        <Button Content="转为时间戳"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnZoneToUnix" />
                        <Button Content="转为农历"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnZoneToLunar" />
                        <Button Content="转为地方时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnZoneToLocal" />
                    </StackPanel>

                    <TextBlock x:Name="ZoneResultTextBlock"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 地方时转换模块 -->
            <materialDesign:Card Margin="0 0 0 6">
                <StackPanel Margin="16">
                    <ci:IconText Kind="MapMarkerOutline" Text="地方时" Margin="0 0 0 8" />

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalendarOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="日期输入" FontSize="14" />
                            <TextBlock Text="年 / 月 / 日"
                                       FontSize="12"
                                       Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <helpers:WpfNumericUpDown x:Name="LocalYearTextBox"
                                                      Width="120"
                                                      Minimum="1" Maximum="9999"
                                                      Increment="1"
                                                      FormatString="0"
                                                      ValueChanged="OnLocalValueChanged" />
                            <ComboBox x:Name="LocalMonthComboBox"
                                      Width="80"
                                      Margin="4 0 0 0"
                                      SelectionChanged="OnLocalSelectionChanged" />
                            <ComboBox x:Name="LocalDayComboBox"
                                      Width="80"
                                      Margin="4 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="时间"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <helpers:WpfTimePicker x:Name="LocalTimePicker"
                                               Grid.Column="2"
                                               Width="250"
                                               ClockIdentifier="24HourClock"
                                               UseSeconds="True"
                                               HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="MapMarkerRadius"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="经度" FontSize="14" />
                            <TextBlock Text="东经正数，西经负数，范围 (-180, 180]"
                                       FontSize="12"
                                       Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <helpers:WpfNumericUpDown x:Name="LocalLongitudeTextBox"
                                                      Width="175"
                                                      Minimum="-180" Maximum="180"
                                                      Increment="0.1"
                                                      FormatString="0.###"
                                                      Value="116.4"
                                                      ValueChanged="OnLongitudeTextBoxChanged" />
                            <StackPanel x:Name="LocalLongitudeDmsPanel"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <helpers:WpfNumericUpDown x:Name="LocalLongitudeDmsDegreesTextBox"
                                                          Width="125"
                                                          Minimum="0" Maximum="180"
                                                          Increment="1"
                                                          ValueChanged="OnLongitudeDmsValueChanged" />
                                <TextBlock Text="°" VerticalAlignment="Center" />
                                <helpers:WpfNumericUpDown x:Name="LocalLongitudeDmsMinutesTextBox"
                                                          Width="120"
                                                          Minimum="0" Maximum="59"
                                                          Increment="1"
                                                          ValueChanged="OnLongitudeDmsValueChanged" />
                                <TextBlock Text="′" VerticalAlignment="Center" />
                                <helpers:WpfNumericUpDown x:Name="LocalLongitudeDmsSecondsTextBox"
                                                          Width="120"
                                                          Minimum="0" Maximum="59"
                                                          Increment="1"
                                                          ValueChanged="OnLongitudeDmsValueChanged" />
                                <TextBlock Text="″" VerticalAlignment="Center" />
                                <ComboBox x:Name="LocalLongitudeDmsDirectionComboBox"
                                          Width="90"
                                          Margin="4 0 0 0"
                                          SelectionChanged="OnLongitudeDmsSelectionChanged">
                                    <ComboBoxItem Content="东经" />
                                    <ComboBoxItem Content="西经" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="WeatherSunnyAlert"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 6 0" />
                        <TextBlock Grid.Column="1"
                                   Text="夏令时"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="LocalDstCheckBox"
                                  Grid.Column="2"
                                  Content="开启"
                                  HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <Button Content="转为北京时间"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnLocalToBeijing" />
                        <Button Content="转为时间戳"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnLocalToUnix" />
                        <Button Content="转为农历"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Margin="0 0 8 0"
                                Click="OnLocalToLunar" />
                        <Button Content="转为区时"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnLocalToZone" />
                    </StackPanel>

                    <TextBlock x:Name="LocalResultTextBlock"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
