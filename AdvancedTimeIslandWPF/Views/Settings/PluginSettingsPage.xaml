<UserControl x:Class="AdvancedTimeIsland.Views.Settings.PluginSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource HarmonyOsSans}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">
            <ci:IconText Kind="CogOutline" Text="插件设置" Margin="0 0 0 8" />

            <TextBlock x:Name="LicenseTextBlock"
                       Text="本项目基于 GNU GENERAL PUBLIC LICENSE v3.0 获得许可"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Opacity="0.75" />

            <!-- 管理启用的功能 -->
            <ci:SettingsCard IconGlyph="Cog"
                             Header="管理启用的功能"
                             Description="点击管理各类功能的启用状态"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <Button Content="管理启用的功能..."
                            Width="165"
                            Click="OnManageFeaturesClick" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="TuneVertical" Text="通用设置" Margin="0 0 0 8" />

            <!-- 通用设置 -->
            <materialDesign:Card Margin="0 0 0 6" HorizontalAlignment="Stretch">
                <StackPanel Margin="16">
                    <ci:SettingsControl x:Name="LongitudeItem"
                                         IconGlyph="MapMarker"
                                         Header="地方时经度"
                                         Description="设置地方时计算使用的经度（范围：-180 到 180）"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="LongitudeModeItem"
                                         IconGlyph="MapSearchOutline"
                                         Header="经纬度表示方式"
                                         Description="选择经度的显示格式"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="TimeZoneItem"
                                         IconGlyph="ClockOutline"
                                         Header="区时时区"
                                         Description="选择区时显示使用的时区"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="TimeOffsetItem"
                                         IconGlyph="TimerOffOutline"
                                         Header="插件时间偏移"
                                         Description="与ClassIsland时间独立，单位为秒，增大偏移抵消铃声滞后，减小偏移抵消铃声提前"
                                         Margin="0,8,0,0" />

                    <!-- 时间同步设置（32 位时替换为警告，见代码） -->
                    <ci:SettingsControl x:Name="NtpServerItem"
                                         IconGlyph="Server"
                                         Header="时间服务器"
                                         Description="选择用于同步时间的NTP服务器"
                                         Margin="0,8,0,0"
                                         Visibility="Collapsed" />

                    <ci:SettingsControl x:Name="NtpIntervalItem"
                                         IconGlyph="Update"
                                         Header="同步时间周期"
                                         Description="NTP时间同步周期，单位为分钟"
                                         Margin="0,8,0,0"
                                         Visibility="Collapsed" />

                    <ContentControl x:Name="NtpWarningHost" Visibility="Collapsed" />
                </StackPanel>
            </materialDesign:Card>

            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="CalendarTextOutline" Text="悬浮时间表" Margin="0 0 0 8" />

            <!-- 悬浮时间表设置 -->
            <materialDesign:Card Margin="0 0 0 6" HorizontalAlignment="Stretch">
                <StackPanel Margin="16">
                    <ci:SettingsControl x:Name="EnableFloatingScheduleItem"
                                         IconGlyph="CalendarClock"
                                         Header="启用悬浮时间表"
                                         Description="在桌面显示半透明悬浮窗，呈现今日课程时间表"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleLayerItem"
                                         IconGlyph="LayersOutline"
                                         Header="悬浮窗层级"
                                         Description="默认为置底。置顶会遮挡其他窗口，不推荐"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleTopmostRefreshItem"
                                         IconGlyph="AvTimer"
                                         Header="悬浮窗层级设置频率"
                                         Description="ClassIsland 在什么时候重新设置悬浮窗层级（置底/置顶）。用于防止其他窗口挤占悬浮窗层级；高频设置会带来性能占用并可能导致界面轻微闪烁。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleHideModeItem"
                                         IconGlyph="EyeOffOutline"
                                         Header="隐藏悬浮窗"
                                         Description="在什么条件下自动隐藏悬浮窗。跟随主界面隐藏规则（默认）/ 基础模式 / 高级模式（规则集）/ 从不隐藏；基础与高级模式均复用 ClassIsland 主界面的隐藏开关与规则集。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleOpacityItem"
                                         IconGlyph="Opacity"
                                         Header="背景不透明度"
                                         Description="仅作用卡片背景（不影响文字/进度条可读性）：1.0 完全不透明，0 完全透明；默认 0.85"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleFontScaleItem"
                                         IconGlyph="FormatSize"
                                         Header="课程名字号"
                                         Description="课程名字体大小（单位 pt，范围 8 ~ 32，默认 18）；表头/时间/老师文字会按相对差值自动缩放"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleFullTeacherNameItem"
                                         IconGlyph="AccountEditOutline"
                                         Header="启用教师全名（不推荐）"
                                         Description="关闭时显示&quot;X老师&quot;（如：张老师）；开启后直接显示完整教师名（如：张三）。当科目未填写教师信息时不显示教师名。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleClickThroughItem"
                                         IconGlyph="TapIn"
                                         Header="启用点击穿透"
                                         Description="开启后，悬浮窗对鼠标点击完全透明（点击会命中下方窗口），同时关闭悬浮窗拖拽（关闭穿透后恢复）。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleEdgeHideItem"
                                         IconGlyph="ArrowCollapseHorizontal"
                                         Header="贴边自动隐藏"
                                         Description="开启后，悬浮时间表贴近屏幕边缘（&lt;8px）时沿该边滑出、只保留约 6px 可见条；指针移入可见条滑回，离开后再次隐藏。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleEdgeHideDelayItem"
                                         IconGlyph="AvTimer"
                                         Header="贴边隐藏延迟时间（秒）"
                                         Description="判定贴边（且指针离开）后等待本时长再滑出隐藏；范围 0 ~ 60，步长 1，精确到 0.1，默认 3 秒；0 表示立即隐藏。仅在开启贴边自动隐藏时生效。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleHoverFadeItem"
                                         IconGlyph="ColorPicker"
                                         Header="指针移入淡化"
                                         Description="参考 ClassIsland 主窗体淡化：当鼠标指针进入悬浮窗区域时，整体不透明度降到 5%；移出后恢复用户设置的背景不透明度。"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="FloatingScheduleHoverFadeReverseItem"
                                         IconGlyph="SwapVertical"
                                         Header="指针移入淡化（反转）"
                                         Description="仅在上一项启用时生效：反转淡化触发方向（指针在悬浮窗&#x2D;外&#x2D;时淡化，移入窗口内恢复不透明）。"
                                         Margin="0,8,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="FlaskOutline" Text="实验性功能" Margin="0 0 0 8" />

            <!-- 实验性功能 -->
            <ci:SettingsControl x:Name="ExperimentalItem"
                                 IconGlyph="Flask"
                                 Header="实验性功能"
                                 Description="启用后可以使用实验性功能，不保证其稳定性;启用一些小众的,不太受欢迎的,以及可能与插件主要功能无关的功能和跨插件联动的功能。"
                                 Margin="0,12,0,0" />

            <!-- 女装彩蛋（默认隐藏） -->
            <ci:SettingsControl x:Name="EasterEggItem"
                                 IconGlyph="Cloth"
                                 Header="女装"
                                 Description="开启后显示女装彩蛋页面"
                                 Margin="0,12,0,0"
                                 Visibility="Collapsed" />

            <!-- 回声洞（实验性功能） -->
            <Button x:Name="EchoHoleButton"
                    Content="回声洞"
                    Margin="0,12,0,0"
                    Visibility="Collapsed"
                    Click="OnEchoHoleButtonClick" />
            <TextBlock x:Name="EchoHoleDisplayText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
