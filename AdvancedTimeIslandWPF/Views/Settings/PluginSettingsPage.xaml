<UserControl x:Class="AdvancedTimeIsland.Views.Settings.PluginSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource HarmonyOsSans}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">
            <ci:IconText Kind="CogOutline" Text="插件设置" Margin="0 0 0 8" />

            <TextBlock x:Name="LicenseTextBlock"
                       Text="本项目基于 GNU GENERAL PUBLIC LICENSE v3.0 获得许可"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Opacity="0.75" />

            <!-- 管理启用的功能 -->
            <ci:SettingsCard IconGlyph="Cog"
                             Header="管理启用的功能"
                             Description="点击管理各类功能的启用状态"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="管理启用的功能..."
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Click="OnManageFeaturesClick" />
                    </StackPanel>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="TuneVertical" Text="通用设置" Margin="0 0 0 8" />

            <!-- 通用设置 -->
            <materialDesign:Card Margin="0 0 0 6" HorizontalAlignment="Stretch">
                <StackPanel Margin="16">
                    <ci:SettingsControl x:Name="LongitudeItem"
                                         IconGlyph="MapMarker"
                                         Header="地方时经度"
                                         Description="设置地方时计算使用的经度（范围：-180 到 180）"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="LongitudeModeItem"
                                         IconGlyph="MapSearchOutline"
                                         Header="经纬度表示方式"
                                         Description="选择经度的显示格式"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="TimeZoneItem"
                                         IconGlyph="ClockOutline"
                                         Header="区时时区"
                                         Description="选择区时显示使用的时区"
                                         Margin="0,8,0,0" />

                    <ci:SettingsControl x:Name="TimeOffsetItem"
                                         IconGlyph="TimerOffOutline"
                                         Header="插件时间偏移"
                                         Description="与ClassIsland时间独立，单位为秒，增大偏移抵消铃声滞后，减小偏移抵消铃声提前"
                                         Margin="0,8,0,0" />

                    <!-- 时间同步设置（32 位时替换为警告，见代码） -->
                    <ci:SettingsControl x:Name="NtpServerItem"
                                         IconGlyph="Server"
                                         Header="时间服务器"
                                         Description="选择用于同步时间的NTP服务器"
                                         Margin="0,8,0,0"
                                         Visibility="Collapsed" />

                    <ci:SettingsControl x:Name="NtpIntervalItem"
                                         IconGlyph="Update"
                                         Header="同步时间周期"
                                         Description="NTP时间同步周期，单位为分钟"
                                         Margin="0,8,0,0"
                                         Visibility="Collapsed" />

                    <ContentControl x:Name="NtpWarningHost" Visibility="Collapsed" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 悬浮时间表设置已拆分至独立页面 FloatingScheduleSettingsPage（"时间表悬浮窗"） -->

            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="FlaskOutline" Text="实验性功能" Margin="0 0 0 8" />

            <!-- 实验性功能 -->
            <ci:SettingsControl x:Name="ExperimentalItem"
                                 IconGlyph="Flask"
                                 Header="实验性功能"
                                 Description="启用后可以使用实验性功能，不保证其稳定性;启用一些小众的,不太受欢迎的,以及可能与插件主要功能无关的功能和跨插件联动的功能。"
                                 Margin="0,12,0,0" />

            <!-- 女装彩蛋（默认隐藏） -->
            <ci:SettingsControl x:Name="EasterEggItem"
                                 IconGlyph="Cloth"
                                 Header="女装"
                                 Description="开启后显示女装彩蛋页面"
                                 Margin="0,12,0,0"
                                 Visibility="Collapsed" />

            <!-- 回声洞（实验性功能） -->
            <Button x:Name="EchoHoleButton"
                    Content="回声洞"
                    Margin="0,12,0,0"
                    Visibility="Collapsed"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left"
                    Click="OnEchoHoleButtonClick" />
            <TextBlock x:Name="EchoHoleDisplayText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
