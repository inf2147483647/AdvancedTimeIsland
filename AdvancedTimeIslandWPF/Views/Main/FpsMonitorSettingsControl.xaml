<ci:ComponentBase x:Class="AdvancedTimeIsland.Views.Main.FpsMonitorSettingsControl"
                  x:TypeArguments="models:FpsMonitorSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:AdvancedTimeIsland.Views.Main"
                  xmlns:models="clr-namespace:AdvancedTimeIsland.Models"
                  xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                  mc:Ignorable="d"
                  d:DesignHeight="700" d:DesignWidth="800"
                  DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:FpsMonitorSettingsControl}}"
                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                  Background="{DynamicResource MaterialDesignPaper}"
                  FontFamily="{DynamicResource HarmonyOsSans}"
                  TextElement.FontWeight="Regular"
                  TextElement.FontSize="14"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">

            <!-- 启用此组件 -->
            <ci:SettingsCard x:Name="EnableComponentCard"
                             IconGlyph="Speedometer"
                             Header="启用此组件"
                             Description="启用后将在主界面显示 FPS 监控"
                             Margin="0,4" />

            <!-- 标签样式 -->
            <ci:IconText Kind="Speedometer" Text="标签样式" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="LabelFontSizeItem"
                                IconGlyph="FormatSize"
                                Header="文本大小"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155"
                                                  Minimum="1" Maximum="72"
                                                  Increment="1"
                                                  FormatString="0.00"
                                                  HorizontalAlignment="Left"
                                                  ValueChanged="OnLabelFontSizeChanged" />
                        <CheckBox Content="启用自定义大小"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnLabelEnableCustomFontSizeChanged"
                                  Unchecked="OnLabelEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="LabelColorItem"
                                IconGlyph="Palette"
                                Header="文本颜色"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120"
                                                HorizontalAlignment="Left"
                                                ColorChanged="OnLabelColorChanged" />
                        <CheckBox Content="启用自定义颜色"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnLabelEnableCustomFontColorChanged"
                                  Unchecked="OnLabelEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <!-- 值样式 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="Speedometer" Text="值样式" Margin="0 0 0 8" />

            <TextBlock Text="默认颜色根据FPS自动变化（>=30绿色，20-30黄色，&lt;20红色），启用自定义颜色后将使用固定颜色"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       Margin="0,0,0,4" />

            <ci:SettingsControl x:Name="ValueFontSizeItem"
                                IconGlyph="FormatSize"
                                Header="文本大小"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155"
                                                  Minimum="1" Maximum="72"
                                                  Increment="1"
                                                  FormatString="0.00"
                                                  HorizontalAlignment="Left"
                                                  ValueChanged="OnValueFontSizeChanged" />
                        <CheckBox Content="启用自定义大小"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnValueEnableCustomFontSizeChanged"
                                  Unchecked="OnValueEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ValueColorItem"
                                IconGlyph="Palette"
                                Header="文本颜色"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120"
                                                HorizontalAlignment="Left"
                                                ColorChanged="OnValueColorChanged" />
                        <CheckBox Content="启用自定义颜色"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnValueEnableCustomFontColorChanged"
                                  Unchecked="OnValueEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
