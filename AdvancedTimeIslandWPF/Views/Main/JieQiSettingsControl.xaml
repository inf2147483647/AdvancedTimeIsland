<ci:ComponentBase x:Class="AdvancedTimeIsland.Views.Main.JieQiSettingsControl"
                  x:TypeArguments="models:JieQiSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:AdvancedTimeIsland.Views.Main"
                  xmlns:models="clr-namespace:AdvancedTimeIsland.Models"
                  xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                  mc:Ignorable="d"
                  d:DesignHeight="700" d:DesignWidth="800"
                  DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:JieQiSettingsControl}}"
                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                  Background="{DynamicResource MaterialDesignPaper}"
                  FontFamily="{DynamicResource HarmonyOsSans}"
                  TextElement.FontWeight="Regular"
                  TextElement.FontSize="14"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">

            <!-- 标签样式 -->
            <ci:IconText Kind="FormatSize" Text="标签样式" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="LabelFontSizeItem"
                                 IconGlyph="FormatSize"
                                 Header="文本大小"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155"
                                                  Minimum="1" Maximum="72"
                                                  Increment="1"
                                                  FormatString="0.00"
                                                  HorizontalAlignment="Left"
                                                  ValueChanged="OnLabelFontSizeChanged" />
                        <CheckBox Content="启用自定义文本大小"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnLabelEnableCustomFontSizeChanged"
                                  Unchecked="OnLabelEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="LabelColorItem"
                                 IconGlyph="Palette"
                                 Header="文本颜色"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120"
                                                HorizontalAlignment="Left"
                                                ColorChanged="OnLabelColorChanged" />
                        <CheckBox Content="启用自定义文本颜色"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnLabelEnableCustomFontColorChanged"
                                  Unchecked="OnLabelEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="LabelFontFamilyItem"
                                 IconGlyph="FormatFont"
                                 Header="字体样式"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnLabelFontFamilyChanged" />
                        <CheckBox Content="启用自定义字体样式"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnLabelEnableCustomFontFamilyChanged"
                                  Unchecked="OnLabelEnableCustomFontFamilyChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="LabelFontWeightItem"
                                 IconGlyph="FormatBold"
                                 Header="字重"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnLabelFontWeightChanged" />
                        <CheckBox Content="启用自定义字重"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnLabelEnableCustomFontWeightChanged"
                                  Unchecked="OnLabelEnableCustomFontWeightChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="需要对应字体支持所选字重"
                       FontSize="12"
                       Foreground="Orange"
                       Margin="0,2,0,8" />

            <!-- 值样式 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="FormatSize" Text="值样式" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="ValueFontSizeItem"
                                 IconGlyph="FormatSize"
                                 Header="文本大小"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155"
                                                  Minimum="1" Maximum="72"
                                                  Increment="1"
                                                  FormatString="0.00"
                                                  HorizontalAlignment="Left"
                                                  ValueChanged="OnValueFontSizeChanged" />
                        <CheckBox Content="启用自定义文本大小"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnValueEnableCustomFontSizeChanged"
                                  Unchecked="OnValueEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ValueColorItem"
                                 IconGlyph="Palette"
                                 Header="文本颜色"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120"
                                                HorizontalAlignment="Left"
                                                ColorChanged="OnValueColorChanged" />
                        <CheckBox Content="启用自定义文本颜色"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnValueEnableCustomFontColorChanged"
                                  Unchecked="OnValueEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ValueFontFamilyItem"
                                 IconGlyph="FormatFont"
                                 Header="字体样式"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnValueFontFamilyChanged" />
                        <CheckBox Content="启用自定义字体样式"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnValueEnableCustomFontFamilyChanged"
                                  Unchecked="OnValueEnableCustomFontFamilyChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="ValueFontWeightItem"
                                 IconGlyph="FormatBold"
                                 Header="字重"
                                 Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnValueFontWeightChanged" />
                        <CheckBox Content="启用自定义字重"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnValueEnableCustomFontWeightChanged"
                                  Unchecked="OnValueEnableCustomFontWeightChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="需要对应字体支持所选字重"
                       FontSize="12"
                       Foreground="Orange"
                       Margin="0,2,0,8" />

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
