<ci:ComponentBase x:Class="AdvancedTimeIsland.Views.Main.AdvancedDateSettingsControl"
                  x:TypeArguments="models:AdvancedDateSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:AdvancedTimeIsland.Views.Main"
                  xmlns:models="clr-namespace:AdvancedTimeIsland.Models"
                  xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                  mc:Ignorable="d"
                  d:DesignHeight="700" d:DesignWidth="800"
                  DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:AdvancedDateSettingsControl}}"
                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                  Background="{DynamicResource MaterialDesignPaper}"
                  FontFamily="{DynamicResource HarmonyOsSans}"
                  TextElement.FontWeight="Regular"
                  TextElement.FontSize="14"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">

            <!-- 标题 -->
            <ci:IconText Kind="CalendarOutline" Text="日期设置" Margin="0 0 0 8" />
            <TextBlock Text="配置日期显示选项"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- 显示星期 -->
            <ci:SettingsCard x:Name="ShowWeekDayCard"
                             IconGlyph="CalendarWeek"
                             Header="显示星期"
                             Description="在主界面显示星期"
                             Margin="0,4" />

            <!-- 内容组合 -->
            <ci:SettingsControl x:Name="ContentOrderItem"
                                IconGlyph="Sort"
                                Header="内容组合"
                                Description="日期与星期的显示顺序"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnContentOrderChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <!-- 日期分隔符 -->
            <ci:SettingsControl x:Name="DateSeparatorItem"
                                IconGlyph="RhombusSplit"
                                Header="日期分隔符"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnDateSeparatorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <!-- 日期样式 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="CalendarOutline" Text="日期样式" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="DateFontSizeItem"
                                IconGlyph="FormatSize"
                                Header="文本大小"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155"
                                                  Minimum="1" Maximum="72"
                                                  Increment="1"
                                                  FormatString="0.00"
                                                  HorizontalAlignment="Left"
                                                  ValueChanged="OnDateFontSizeChanged" />
                        <CheckBox Content="启用自定义文本大小"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnDateEnableCustomFontSizeChanged"
                                  Unchecked="OnDateEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="DateColorItem"
                                IconGlyph="Palette"
                                Header="文本颜色"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120"
                                                HorizontalAlignment="Left"
                                                ColorChanged="OnDateColorChanged" />
                        <CheckBox Content="启用自定义文本颜色"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnDateEnableCustomFontColorChanged"
                                  Unchecked="OnDateEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="DateFontFamilyItem"
                                IconGlyph="FormatFont"
                                Header="字体样式"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnDateFontFamilyChanged" />
                        <CheckBox Content="启用自定义字体样式"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnDateEnableCustomFontFamilyChanged"
                                  Unchecked="OnDateEnableCustomFontFamilyChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="DateFontWeightItem"
                                IconGlyph="FormatBold"
                                Header="字重"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnDateFontWeightChanged" />
                        <CheckBox Content="启用自定义字重"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnDateEnableCustomFontWeightChanged"
                                  Unchecked="OnDateEnableCustomFontWeightChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="需要对应字体支持所选字重"
                       FontSize="12"
                       Foreground="Orange"
                       Margin="0,2,0,8" />

            <!-- 星期样式 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="CalendarOutline" Text="星期样式" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="WeekDayFontSizeItem"
                                IconGlyph="FormatSize"
                                Header="文本大小"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155"
                                                  Minimum="1" Maximum="72"
                                                  Increment="1"
                                                  FormatString="0.00"
                                                  HorizontalAlignment="Left"
                                                  ValueChanged="OnWeekDayFontSizeChanged" />
                        <CheckBox Content="启用自定义文本大小"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnWeekDayEnableCustomFontSizeChanged"
                                  Unchecked="OnWeekDayEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="WeekDayColorItem"
                                IconGlyph="Palette"
                                Header="文本颜色"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120"
                                                HorizontalAlignment="Left"
                                                ColorChanged="OnWeekDayColorChanged" />
                        <CheckBox Content="启用自定义文本颜色"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnWeekDayEnableCustomFontColorChanged"
                                  Unchecked="OnWeekDayEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="WeekDayFontFamilyItem"
                                IconGlyph="FormatFont"
                                Header="字体样式"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnWeekDayFontFamilyChanged" />
                        <CheckBox Content="启用自定义字体样式"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnWeekDayEnableCustomFontFamilyChanged"
                                  Unchecked="OnWeekDayEnableCustomFontFamilyChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="WeekDayFontWeightItem"
                                IconGlyph="FormatBold"
                                Header="字重"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnWeekDayFontWeightChanged" />
                        <CheckBox Content="启用自定义字重"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnWeekDayEnableCustomFontWeightChanged"
                                  Unchecked="OnWeekDayEnableCustomFontWeightChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="需要对应字体支持所选字重"
                       FontSize="12"
                       Foreground="Orange"
                       Margin="0,2,0,8" />

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
