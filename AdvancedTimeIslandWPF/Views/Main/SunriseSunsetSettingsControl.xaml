<ci:ComponentBase x:Class="AdvancedTimeIsland.Views.Main.SunriseSunsetSettingsControl"
                  x:TypeArguments="models:SunriseSunsetSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:AdvancedTimeIsland.Views.Main"
                  xmlns:models="clr-namespace:AdvancedTimeIsland.Models"
                  xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                  mc:Ignorable="d"
                  d:DesignHeight="900" d:DesignWidth="800"
                  DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SunriseSunsetSettingsControl}}"
                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                  Background="{DynamicResource MaterialDesignPaper}"
                  FontFamily="{DynamicResource HarmonyOsSans}"
                  TextElement.FontWeight="Regular"
                  TextElement.FontSize="14"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{DynamicResource SettingsPageStackPanelStyle}">

            <!-- 标题 -->
            <ci:IconText Kind="WeatherSunny" Text="日出日落设置" Margin="0 0 0 8" />
            <TextBlock Text="配置日出日落时间显示选项"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- 经纬度设置 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="MapMarker" Text="经纬度设置" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="LongitudeItem"
                                IconGlyph="MapMarker"
                                Header="经度"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="120"
                                 HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBox Width="50" />
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="1,0" />
                            <TextBox Width="45" />
                            <TextBlock Text="′" VerticalAlignment="Center" Margin="1,0" />
                            <TextBox Width="45" />
                            <TextBlock Text="″" VerticalAlignment="Center" Margin="1,0" />
                            <ComboBox Width="90" />
                        </StackPanel>
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="LatitudeItem"
                                IconGlyph="MapMarker"
                                Header="纬度"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="120"
                                 HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBox Width="50" />
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="1,0" />
                            <TextBox Width="45" />
                            <TextBlock Text="′" VerticalAlignment="Center" Margin="1,0" />
                            <TextBox Width="45" />
                            <TextBlock Text="″" VerticalAlignment="Center" Margin="1,0" />
                            <ComboBox Width="90" />
                        </StackPanel>
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="GetLocationItem"
                                IconGlyph="CrosshairsGps"
                                Header="获取当前位置"
                                Description="通过 IP 定位自动获取经纬度"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="获取当前位置"
                                Padding="8,4,8,4"
                                HorizontalAlignment="Left"
                                Click="OnGetLocationClick" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,4,0,4" />

            <!-- 时区设置 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="ClockOutline" Text="时区设置" Margin="0 0 0 8" />

            <ci:SettingsControl x:Name="TimeZoneItem"
                                IconGlyph="ClockOutline"
                                Header="时区"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnTimeZoneChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <ci:SettingsControl x:Name="GetTimeZoneItem"
                                IconGlyph="Update"
                                Header="获取时区"
                                Description="通过 IP 定位自动获取时区"
                                Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="获取时区"
                                Padding="6,3,6,3"
                                HorizontalAlignment="Left"
                                Click="OnGetTimeZoneClick" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <!-- 字体样式 -->
            <Separator Margin="0 16 0 8" />
            <ci:IconText Kind="FormatSize" Text="字体样式" Margin="0 0 0 8" />

            <TextBlock Text="日出标签样式" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" />
            <ci:SettingsControl x:Name="SunriseLabelFontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155" Minimum="1" Maximum="72" Increment="1" FormatString="0.00" HorizontalAlignment="Left" ValueChanged="OnSunriseLabelFontSizeChanged" />
                        <CheckBox Content="启用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunriseLabelEnableCustomFontSizeChanged" Unchecked="OnSunriseLabelEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>
            <ci:SettingsControl x:Name="SunriseLabelColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnSunriseLabelColorChanged" />
                        <CheckBox Content="启用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunriseLabelEnableCustomFontColorChanged" Unchecked="OnSunriseLabelEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="日出时间样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
            <ci:SettingsControl x:Name="SunriseTimeFontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155" Minimum="1" Maximum="72" Increment="1" FormatString="0.00" HorizontalAlignment="Left" ValueChanged="OnSunriseTimeFontSizeChanged" />
                        <CheckBox Content="启用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunriseTimeEnableCustomFontSizeChanged" Unchecked="OnSunriseTimeEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>
            <ci:SettingsControl x:Name="SunriseTimeColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnSunriseTimeColorChanged" />
                        <CheckBox Content="启用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunriseTimeEnableCustomFontColorChanged" Unchecked="OnSunriseTimeEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="日落标签样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
            <ci:SettingsControl x:Name="SunsetLabelFontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155" Minimum="1" Maximum="72" Increment="1" FormatString="0.00" HorizontalAlignment="Left" ValueChanged="OnSunsetLabelFontSizeChanged" />
                        <CheckBox Content="启用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunsetLabelEnableCustomFontSizeChanged" Unchecked="OnSunsetLabelEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>
            <ci:SettingsControl x:Name="SunsetLabelColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnSunsetLabelColorChanged" />
                        <CheckBox Content="启用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunsetLabelEnableCustomFontColorChanged" Unchecked="OnSunsetLabelEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

            <TextBlock Text="日落时间样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
            <ci:SettingsControl x:Name="SunsetTimeFontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfNumericUpDown Width="155" Minimum="1" Maximum="72" Increment="1" FormatString="0.00" HorizontalAlignment="Left" ValueChanged="OnSunsetTimeFontSizeChanged" />
                        <CheckBox Content="启用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunsetTimeEnableCustomFontSizeChanged" Unchecked="OnSunsetTimeEnableCustomFontSizeChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>
            <ci:SettingsControl x:Name="SunsetTimeColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                <ci:SettingsControl.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnSunsetTimeColorChanged" />
                        <CheckBox Content="启用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnSunsetTimeEnableCustomFontColorChanged" Unchecked="OnSunsetTimeEnableCustomFontColorChanged" />
                    </StackPanel>
                </ci:SettingsControl.Switcher>
            </ci:SettingsControl>

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
