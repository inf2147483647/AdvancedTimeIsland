<ci:ComponentBase x:Class="AdvancedTimeIsland.Views.Main.PeriodicCountdownSettingsControl"
                  x:TypeArguments="models:PeriodicCountdownSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:AdvancedTimeIsland.Views.Main"
                  xmlns:models="clr-namespace:AdvancedTimeIsland.Models"
                  xmlns:helpers="clr-namespace:AdvancedTimeIsland.Helpers"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                  mc:Ignorable="d"
                  d:DesignHeight="900" d:DesignWidth="800"
                  DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:PeriodicCountdownSettingsControl}}"
                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                  Background="{DynamicResource MaterialDesignPaper}"
                  FontFamily="{DynamicResource HarmonyOsSans}"
                  TextElement.FontWeight="Regular"
                  TextElement.FontSize="14"
                  TextOptions.TextFormattingMode="Ideal"
                  TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="MainPanel" Style="{DynamicResource SettingsPageStackPanelStyle}">

            <!-- 标题 -->
            <ci:IconText Kind="Timer" Text="周期性倒计时设置" Margin="0 0 0 8" />
            <TextBlock Text="配置周期性倒计时显示选项和倒计时列表"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- 文案设置 -->
            <materialDesign:Card Margin="0 0 0 6">
                <Expander Style="{DynamicResource MaterialDesignExpander}" Background="Transparent" IsExpanded="True" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="FormatText"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Header="文案设置"
                                            HasSwitcher="False"
                                            Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <StackPanel>
                            <TextBlock Text="以下内容在主界面上显示的顺序为：文案1->倒计时名称->文案3->剩余时间->文案4"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       Margin="0,4,0,4" />

                            <ci:SettingsControl x:Name="Text1Item"
                                                IconGlyph="FormatText"
                                                Header="文案1"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <ci:SettingsControl x:Name="Text2Item"
                                                IconGlyph="FormatText"
                                                Header="倒计时名称"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="前往编辑倒计时名称"
                                                Style="{DynamicResource MaterialDesignFlatButton}"
                                                HorizontalAlignment="Left"
                                                Click="OnText2ButtonClick" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <ci:SettingsControl x:Name="Text3Item"
                                                IconGlyph="FormatText"
                                                Header="文案3"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <ci:SettingsControl x:Name="Text4Item"
                                                IconGlyph="FormatText"
                                                Header="文案4"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

            <!-- 时间格式 -->
            <materialDesign:Card Margin="0 0 0 6">
                <Expander Style="{DynamicResource MaterialDesignExpander}" Background="Transparent" IsExpanded="True" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="ClockOutline"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Header="时间格式"
                                            HasSwitcher="False"
                                            Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <StackPanel>
                            <ci:SettingsControl x:Name="TimeFormatItem"
                                                IconGlyph="ClockOutline"
                                                Header="时间格式"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <TextBlock Text="格式化变量: %D总天数 %H总小时 %M总分钟 %S总秒 %X总毫秒&#10;%d天 %h小时 %m分钟 %s秒 %x毫秒&#10;%L剩余百分比 %P已过百分比 %p已过百分比(两位)&#10;%yy总年 %YY总年(两位) %mo总月 %MO总月(两位)"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,4" />

                            <ci:SettingsCard x:Name="TimeCorrectionCard"
                                             IconGlyph="Timer"
                                             Header="差一矫正"
                                             Description="当精度不足时最小单位加一"
                                             Margin="0,4" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

            <!-- 时间基准 -->
            <materialDesign:Card Margin="0 0 0 6">
                <Expander Style="{DynamicResource MaterialDesignExpander}" Background="Transparent" IsExpanded="True" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="ClockOutline"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Header="时间基准"
                                            HasSwitcher="False"
                                            Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <StackPanel>
                            <ci:SettingsControl x:Name="TimeBaseItem"
                                                IconGlyph="ClockOutline"
                                                Header="时间基准"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="200"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="OnTimeBaseChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

            <!-- 进度显示 -->
            <materialDesign:Card Margin="0 0 0 6">
                <Expander Style="{DynamicResource MaterialDesignExpander}" Background="Transparent" IsExpanded="True" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="ProgressClock"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Header="进度显示"
                                            HasSwitcher="False"
                                            Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <StackPanel>
                            <ci:SettingsControl x:Name="ProgressDisplayModeItem"
                                                IconGlyph="ProgressClock"
                                                Header="显示进度条"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="160"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="OnProgressDisplayModeChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <ci:SettingsCard x:Name="EnableCustomProgressColorCard"
                                             IconGlyph="Palette"
                                             Header="启用自定义进度颜色"
                                             Margin="0,4" />

                            <ci:SettingsControl x:Name="ProgressBarColorItem"
                                                IconGlyph="Palette"
                                                Header="进度条颜色"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120"
                                                                HorizontalAlignment="Left"
                                                                ColorChanged="OnProgressBarColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <ci:SettingsControl x:Name="ProgressRingColorItem"
                                                IconGlyph="Palette"
                                                Header="进度环颜色"
                                                Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120"
                                                                HorizontalAlignment="Left"
                                                                ColorChanged="OnProgressRingColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

            <!-- 字体样式 -->
            <materialDesign:Card Margin="0 0 0 6">
                <Expander Style="{DynamicResource MaterialDesignExpander}" Background="Transparent" IsExpanded="False" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="FormatFont"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Header="字体样式"
                                            HasSwitcher="False"
                                            Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <StackPanel>
                            <TextBlock Text="文案1样式" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" />
                            <ci:SettingsControl x:Name="Text1FontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="80" HorizontalAlignment="Left" />
                                        <CheckBox Content="使用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText1EnableCustomFontSizeChanged" Unchecked="OnText1EnableCustomFontSizeChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                            <ci:SettingsControl x:Name="Text1ColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnText1ColorChanged" />
                                        <CheckBox Content="使用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText1EnableCustomFontColorChanged" Unchecked="OnText1EnableCustomFontColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <TextBlock Text="文案2样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
                            <ci:SettingsControl x:Name="Text2FontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="80" HorizontalAlignment="Left" />
                                        <CheckBox Content="使用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText2EnableCustomFontSizeChanged" Unchecked="OnText2EnableCustomFontSizeChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                            <ci:SettingsControl x:Name="Text2ColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnText2ColorChanged" />
                                        <CheckBox Content="使用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText2EnableCustomFontColorChanged" Unchecked="OnText2EnableCustomFontColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <TextBlock Text="文案3样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
                            <ci:SettingsControl x:Name="Text3FontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="80" HorizontalAlignment="Left" />
                                        <CheckBox Content="使用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText3EnableCustomFontSizeChanged" Unchecked="OnText3EnableCustomFontSizeChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                            <ci:SettingsControl x:Name="Text3ColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnText3ColorChanged" />
                                        <CheckBox Content="使用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText3EnableCustomFontColorChanged" Unchecked="OnText3EnableCustomFontColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <TextBlock Text="时间样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
                            <ci:SettingsControl x:Name="TimeFontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="80" HorizontalAlignment="Left" />
                                        <CheckBox Content="使用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnTimeEnableCustomFontSizeChanged" Unchecked="OnTimeEnableCustomFontSizeChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                            <ci:SettingsControl x:Name="TimeColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnTimeColorChanged" />
                                        <CheckBox Content="使用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnTimeEnableCustomFontColorChanged" Unchecked="OnTimeEnableCustomFontColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>

                            <TextBlock Text="文案4样式" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" />
                            <ci:SettingsControl x:Name="Text4FontSizeItem" IconGlyph="FormatSize" Header="大小" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="80" HorizontalAlignment="Left" />
                                        <CheckBox Content="使用自定义大小" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText4EnableCustomFontSizeChanged" Unchecked="OnText4EnableCustomFontSizeChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                            <ci:SettingsControl x:Name="Text4ColorItem" IconGlyph="Palette" Header="颜色" Margin="0,4">
                                <ci:SettingsControl.Switcher>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:WpfColorPicker Width="120" HorizontalAlignment="Left" ColorChanged="OnText4ColorChanged" />
                                        <CheckBox Content="使用自定义颜色" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnText4EnableCustomFontColorChanged" Unchecked="OnText4EnableCustomFontColorChanged" />
                                    </StackPanel>
                                </ci:SettingsControl.Switcher>
                            </ci:SettingsControl>
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

            <!-- 倒计时列表 -->
            <materialDesign:Card Margin="0 0 0 6">
                <Expander Style="{DynamicResource MaterialDesignExpander}" Background="Transparent" IsExpanded="True" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="FormatListBulleted"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Header="倒计时列表"
                                            HasSwitcher="False"
                                            Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="倒计时名称"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Opacity="0.75"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="周期"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Opacity="0.75"
                                           HorizontalAlignment="Center"
                                           Grid.Column="1" />
                                <TextBlock Text="启用通知？"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Opacity="0.75"
                                           HorizontalAlignment="Center"
                                           Grid.Column="2" />
                            </Grid>

                            <ListBox x:Name="CountdownListBox"
                                     Height="150"
                                     SelectionMode="Single"
                                     SelectionChanged="OnCountdownListSelectionChanged" />

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="AddButton" Content="添加" Width="60" Style="{DynamicResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Click="OnAddClick" />
                                <Button x:Name="RemoveButton" Content="删除" Width="60" Margin="8,0,0,0" Style="{DynamicResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Click="OnRemoveClick" />
                                <Button x:Name="EditButton" Content="编辑" Width="60" Margin="8,0,0,0" Style="{DynamicResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Click="OnEditClick" />
                            </StackPanel>

                            <TextBlock x:Name="SelectionHintTextBlock"
                                       Text="请选择一个倒计时"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>